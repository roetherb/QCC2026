/*
QCC 2026 CLEOPATRA v1.14 - THREE-PART FLUSH ARTWORK + OUTLINE
Derived directly from v1.13. Facing the screen: +X right, +Y top.

THREE MATERIAL PARTS: Body, Artwork_Inlay, Artwork_Outline.
The outline REPLACES the outer edge of the existing artwork; it does not
expand the artwork, cut the body again, or add any raised detail. The same
inward border is applied around holes within each artwork region.
Nominal outline width in XY: 0.48 mm (one extrusion-width design target).
Artwork and outline are both Z=0..0.48 mm, flush with Body at Z=0.
At 0.24 mm FIRST and normal layer heights, only layers 1-2 contain these
three materials. Layer 3 onward is Body only. Backplate stays 1.44 mm.

The center fill is inset and rounded using a 0.48-mm minimum-feature
opening to suppress thin residual fill slivers. Narrow strokes and small
islands become Outline only where there is no room for both colors. Outline
width increases locally there. Original tapered tips remain in the original
footprint; this does not certify every inherited tip for a 0.4-mm nozzle.
Artwork_Inlay + Artwork_Outline equals the original complete inlay.
Body, complete shell, PCB fit and all mechanical features are UNCHANGED.

Use the THREE-PART 3MF or import all three STLs TOGETHER as ONE multipart
object. Do not arrange, rescale, mirror or drop the art islands separately.
Exporting part="full" fuses the envelope and loses ALL material boundaries;
the resulting single-color STL is intentionally plain. F5 shows colors.

PROCESS: Bambu PETG Basic, H2D, 0.4-mm high-flow tungsten-carbide nozzle.
0.24-mm first and normal layers, 2 walls, 3 bottom/3 top layers, 15% Gyroid.
Suggested wall generator: Arachne for single-line outline regions. Inspect
both first layers using filament and line-width previews. Do not reduce the
bottom shell count to two. The geometry-only 3MF does NOT apply a profile.
Three distinct filaments require a compatible three-color feed arrangement.
No exact-profile slice or physical print has been performed for this change.

All approved artwork polygons are embedded; no SVG or font dependencies.
No hexagonal texture, embossing, new supports, or mechanical alterations.
The 5-mm PCB gap, 2.4-mm structural minimum except the backplate, 0.50-mm
retainer overlaps, support shelf pairs and port/lanyard clearances remain.
See README.md and Validation.json for checks and limitations. Units: mm.
*/
/* [Output] */
// Keep "print" for every exported STL. Other views are inspection only.
view = "print"; // [print,exterior,assembly,section]
// full is the plain union; body/art/outline are three complementary material parts.
// corner_coupon checks one new corner lip and its adjacent production PCB seat.
part = "full"; // [full,body,art,outline,fit_frame,corner_coupon,clip_coupon,switch_coupon,top_lanyard_coupon,bottom_lanyard_coupon,paired_shelves_coupon,modifier_clips,art_coupon,art_coupon_body,art_coupon_art,art_coupon_outline]
// Render mode preview colors do not alter STL geometry.
preview_colors = true;
// Requires PCB_reference.stl alongside this file; displayed only with F5.
show_pcb = false;

/* [Fit - measure before changing] */
// Measured overall PCB thickness including modeled surface layers.
pcb_thickness = 1.64; // [1.2:0.02:2.2]
// Radial clearance PER SIDE, not total width clearance.
edge_clearance = 0.30; // [0.15:0.05:0.65]
// Inside floor to PCB back, including room for existing screws and components.
// Deepest modeled rear pin: 3.86 mm. Installed screw sizes are NOT measured.
// Measure the actual largest rear projection; allow 0.60 mm additional space.
// Changing this value also raises the edge ledges, fixed walls and snap latches.
rear_clearance = 5.00; // [4.5:0.1:10.0]
// Space above the front PCB surface, under the retaining ledge.
clip_vertical_play = 0.30; // [0.20:0.05:0.50]
// Nominal overlap over the PCB edge for ALL FOUR SIDE + ALL FOUR CORNER clips.
// Corner overlap is derived below; there is no independently adjustable corner value.
clip_overlap = 0.50; // [0.25:0.05:0.50]

/* [Structure] */
// Shared minimum. It is NOT the slicer's number of perimeters or an art stroke.
minimum_wall_thickness = 2.40; // [2.4:0.2:3.6]
// Intentional exception: ONLY the backplate is thinner than the wall minimum.
backplate_thickness = 1.44; // [1.44:0.24:2.40]
// Linked dimensions are derived in Hidden; do not override them independently.
// Long in-plane bending arms; intentionally isolated from the floor.
clip_length = 24; // [24:1:25]
flexure_gap = 1.20; // [1.2:0.1:1.6]
// Keep the spine tops at their inherited offsets above the INSIDE floor.
// Radial arm thickness stays 2.40 mm. The low RF arm must follow the PCB down.
side_spine_above_floor = 4.00; // [4.0:0.2:5.6]
end_spine_above_floor = 2.40; // [2.4:0.1:2.6]
root_blend_radius = 1.20; // [1.2:0.2:1.6]
lead_in_height = 1.60; // [1.6:0.2:2.2]
release_tab_projection = 0.80; // [0.8:0.2:1.2]
// Keep each spring/anchor in Body only, including in this three-color cover.
body_only_clip_zones = true;
// Narrow, wall-integrated PCB-edge seats; NOT screw posts or mounting bosses.
// Depth is contact underneath the PCB, excluding its per-side wall clearance.
edge_seat_depth = 0.80; // [0.60:0.05:1.00]
edge_seat_length = 6.00; // [5.0:0.5:7.0]
// Both sides use the same stations; changing a station moves BOTH mates.
lower_edge_seat_y = -60.00; // [-61:0.5:-59]
upper_edge_seat_y = 54.00; // [53:0.5:55]
/* [Lanyard and end clips] */
// OPEN-TO-EDGE cutouts; actual clasp geometry must fit inside this space.
lanyard_clearance = 4.00; // [3.0:0.25:5.0]
// Root is at +/- this X; the flexible arms extend inward toward the opening.
end_clip_root_x = 48.40; // [48.0:0.1:48.4]
// Free inner end remains at |X|=12.50 mm, outside the lanyard clearance.
end_clip_length = 35.90; // [35.0:0.1:35.9]
// Override ONLY the bottom-edge / screen-right arm; root remains unchanged.
bottom_right_end_clip_length = 24.00; // [22.0:0.5:25.0]
// MODEL-derived power housing X; nominal operator margin, NOT finger simulation.
power_access_margin = 4.00; // [3.0:0.5:4.0]

/* [Four corner PCB support shelves] */
corner_supports_enabled = true;
// Each support occupies v=0.30..2.70 within the fixed end-root v=0..3.00.
corner_support_length = 2.40;
corner_support_root_setback = 0.30;
corner_support_depth = 0.80; // [0.6:0.1:0.8]
// 0 = nominal contact; positive lowers these four seats without moving the clips.
corner_support_clearance = 0.00; // [0:0.05:0.3]
// Assumed keepout only; measure actual installed heads before a production run.
corner_screw_head_diameter = 9.00; // [6.0:0.5:9.0]
corner_screw_head_margin = 0.20; // [0.20:0.05:0.40]
/* [Two lanyard backing beams] */
lanyard_beams_enabled = true;
beam_length = 24.00; // [22:1:26]
beam_contact_width = 2.40; // [2.4:0.2:3.0]
beam_foot_flare = 0.80; // [0.6:0.2:1.0]
beam_notch_gap = 1.00; // [1.0:0.2:2.0]
// 0 = nominal direct contact, not pressure preload. Positive lowers the beams.
beam_contact_clearance = 0.00; // [0:0.05:0.3]
/* [Fitting samples] */
// End bands on the fitting frame remain wide enough to connect across the U cuts.
fit_frame_end_band = 18.00; // [17.0:1.0:24.0]

/* [Reversed right-side clip and port clearance] */
// Root is near the side midpoint; arm points DOWN to root_y - clip_length.
right_lower_clip_root_y = 0.00; // [-1:0.5:4]
// Fixed-wall shelf ABOVE the anchor; never underneath the flexible arm.
right_lower_edge_seat_y = 6.00; // [6:0.5:10]
// Keep the former lower clip/USB-C approach free of tall plastic.
lower_right_access_y_min = -70.00; // [-70:0.5:-68]
// Above/below the whole modeled switch housing, not just its present lever position.
switch_access_margin = 4.00; // [3:0.5:5]
// Top of lowered wall, measured below the PCB BACK seating plane.
switch_wall_drop = 0.40; // [0.2:0.2:1.0]

/* [Corner retaining lips] */
// Local corner retainers supplement, not replace, the four original side clips.
corner_lips_enabled = true;
// Corner overlap is locked to clip_overlap in the hidden derived dimensions.
// Nominal gap above the PCB front; actual printed gap is layer/tolerance dependent.
// Corner play follows the common clip_vertical_play setting.
// Inner-wall clearance at the PCB corner, versus edge_clearance on straight sides.
corner_radial_clearance = 0.20; // [0.15:0.05:0.30]
// Curved corner contact span, centered on the diagonal; 50 degrees ~= 4.42 mm.
corner_lip_angle = 50; // [40:5:55]
// Corner-wall thickness is linked to minimum_wall_thickness, not a thin flexure.
// Nominal tangential width of each of two relief slots beside a corner tongue.
corner_slot_gap = 1.20; // [1.2:0.1:1.6]
// Flat lip height is linked to minimum_wall_thickness; inward reach remains 0.50 mm.

/* [Artwork] */
// Depth INSIDE the existing backplate. Default 0.48 = two 0.24-mm layers;
// layer 3 and all later layers contain no Artwork material.
art_inlay_depth = 0.48; // [0.24:0.24:0.72]
// Small blank border, measured from the actual outside shell outline.
art_edge_buffer = 1.60; // [1.6:0.2:3.0]
// Keep both original lanyard apertures clear of the inlaid artwork.
art_hole_buffer = 0.90; // [0.8:0.1:1.5]
art_flexure_buffer = 0.65; // [0.6:0.05:1.0]
// No raised background, perimeter rails, lanyard rims or hexagonal lattice.
// Stroke >= 0.65 mm with a 0.4 mm nozzle.
art_stroke = 0.85; // [0.7:0.05:1.1]


/* [Artwork outline] */
// In-plane border width, NOT the 0.48-mm Z depth. The border grows INWARDS.
outline_width = 0.48; // [0.44:0.02:0.64]
// Suppresses narrow residual center-fill fragments; lost fill becomes Outline.
minimum_fill_width = 0.48; // [0.44:0.02:0.64]

/* [Hidden] */
assert(outline_width >= 0.44, "Use >=0.44 mm nominal outline for this 0.4-mm nozzle design.");
assert(minimum_fill_width >= 0.44, "Do not reintroduce sub-nozzle center-fill slivers.");
corner_vertical_play = clip_vertical_play;
corner_root_radius = root_blend_radius;
// Locked: all material faces share the backplate plane Z=0. Do not override.
relief_height = 0;

// Corner radius is faceted at this full-circle resolution. The small radial
// allowance below keeps facet-normal wall thickness >= the requested minimum.
corner_segments = 192;
corner_facet_allowance = minimum_wall_thickness / cos(180/corner_segments) - minimum_wall_thickness + 0.002;
floor_thickness = backplate_thickness;
side_spine_height = floor_thickness + side_spine_above_floor;
end_spine_height = floor_thickness + end_spine_above_floor;
wall_thickness = minimum_wall_thickness + corner_facet_allowance;
clip_wall = minimum_wall_thickness;
corner_flex_wall = wall_thickness;
edge_seat_thickness = minimum_wall_thickness;
side_lip_thickness = minimum_wall_thickness;
corner_lip_thickness = minimum_wall_thickness;
// Linked alias: do not override independently. Measured radially at the corners.
corner_lip_overlap = clip_overlap;
// Process references only; OpenSCAD/STL cannot apply these to a slicer.
process_layer_height = 0.24;
process_first_layer_height = 0.24;
process_perimeters = 2;
process_top_layers = 3;
process_bottom_layers = 3;
process_sparse_infill_percent = 15;
process_sparse_infill_pattern = "gyroid";
$fn = 48;
eps = 0.015;
reference_width = 107.92482;
reference_height = 152.37490;
source_center = [53.97511, 76.20015];
board_half_x = reference_width/2;
arm_inner_x = board_half_x + edge_clearance;
seat_z = floor_thickness + rear_clearance;
front_z = seat_z + pcb_thickness;
latch_z = front_z + clip_vertical_play;
latch_inset = edge_clearance + clip_overlap;
arm_top = latch_z + side_lip_thickness + lead_in_height;
root_length = 3.00;
// Explicit side-specific positions prevent accidental left/right mirroring.
// [side (-1 left/+1 right), ROOT Y, direction from root toward free end].
side_clip_specs = [[-1,-57,1],[-1,23,1],[1,right_lower_clip_root_y,-1],[1,23,1]];
right_lower_clip_tip_y = right_lower_clip_root_y - clip_length;
board_half_y = reference_height/2;
bottom_right_end_tip_x = end_clip_root_x-bottom_right_end_clip_length;
power_source_x_min = 64.20393700787403;
power_source_x_max = 72.80393700787403;
power_source_actuator_y_min = 7.85002561;
power_access_x_min = power_source_x_min-source_center[0]-power_access_margin;
power_access_x_max = power_source_x_max-source_center[0]+power_access_margin;
// Source OBJ VOLUME switch housing and contacts: X=99.3502..103.8502,
// Y=36.3401..44.9401, Z=-3.2000..3.9937; lever reaches X=106.4502.
switch_source_y_min = 36.34008128;
switch_source_y_max = 44.94008128;
// Keep this band independent of the relocated clip: no tall wall is restored
// into the USB-C approach when the clip moves or reverses direction.
switch_access_y_min = lower_right_access_y_min;
switch_access_y_max = switch_source_y_max-source_center[1]+switch_access_margin;
// Actual PCB lanyard geometry, separate from the cover cutout.
pcb_slot_width = 14.732;
pcb_slot_height = 3.048;
notch_half_width = pcb_slot_width/2+lanyard_clearance;
// These fixed-wall zones are clear of modeled rear components and clip slots.
// Six original screw positions are deliberately not used by the cover.
// Six support lands: every side station has an opposite-wall mate.
edge_seat_stations = [lower_edge_seat_y,right_lower_edge_seat_y,upper_edge_seat_y];
edge_seat_specs = [for(s=[-1,1],y=edge_seat_stations) [s,y]];
// Fitted quarter-circle geometry from the actual PCB outline, not bounding corners.
corner_center_x = 48.89510;
corner_center_y = 71.12014;
corner_radius = 5.06731;
corner_latch_z = front_z + corner_vertical_play;
corner_top = corner_latch_z + corner_lip_thickness + lead_in_height;
// Slots start above the floor; the protective floor and exterior relief stay intact.
corner_slot_bottom = floor_thickness + 0.40;
corner_root_top = floor_thickness + 1.40;
// Convert a nominal tangential slot width to degrees at the outside of the tongue.
corner_slot_angle = corner_slot_gap / (corner_radius + edge_clearance + corner_flex_wall) * 180 / PI;
corner_cut_angle = corner_lip_angle + 2*corner_slot_angle;
// Real lower slot is offset 0.254 mm left of the upper slot.
lanyard_centers = [[-0.25403,-69.59605],[-0.00003,69.59614]];

// Relocation and clearance constraints for this PCB; verify before overriding.
assert(bottom_right_end_clip_length>=22 && bottom_right_end_clip_length<=25,
       "Keep the shortened END arm in the checked 22..25-mm range.");
assert(bottom_right_end_tip_x>=power_access_x_max+0.5,
       "Shortened arm must clear the POWER housing plus the operator margin.");
assert(corner_support_length>=minimum_wall_thickness,
       "Corner shelf must be at least the structural minimum in length.");
assert(corner_support_root_setback>=0.20 &&
       corner_support_root_setback+corner_support_length<=root_length-0.20,
       "Shelves must stay in fixed end-root lands, not brace a flexible arm.");
assert(corner_support_depth>=0.60 && corner_support_depth<=0.80);
assert(corner_support_clearance>=0 && corner_support_clearance<=0.30);
echo("Shortened bottom-right END arm: root X / length / free tip X mm",
     [end_clip_root_x,bottom_right_end_clip_length,bottom_right_end_tip_x]);
echo("POWER housing-to-arm X separation mm",
     bottom_right_end_tip_x-(power_source_x_max-source_center[0]));
echo("Corner shelves: count / length / maximum PCB overlap / top Z mm",
     [corner_supports_enabled?4:0,corner_support_length,corner_support_depth,
      seat_z-corner_support_clearance]);
assert(right_lower_clip_tip_y >= switch_access_y_max+2.0,
       "Keep the entire reversed arm >= 2 mm above the switch access band.");
assert(right_lower_edge_seat_y-edge_seat_length/2 >= right_lower_clip_root_y+root_blend_radius,
       "Fixed-wall shelf must be ABOVE the root, not across the flexible arm.");
assert(right_lower_edge_seat_y+edge_seat_length/2 < 23-root_blend_radius,
       "Keep the relocated shelf below the upper-right clip's root.");
assert(switch_access_y_min <= switch_source_y_min-source_center[1]-switch_access_margin,
       "Access band must include the whole switch and requested lower clearance.");
assert(lower_right_access_y_min >= -70,
       "Do not cut into the lower-right corner-retainer root.");
assert(end_clip_length >= 35 && end_clip_length <= 35.9,
       "Recheck RF hardware and root position outside this end-arm range.");
assert(end_clip_root_x <= 48.4 && end_clip_root_x >= 48,
       "Keep end roots on the straight edge before the corner arc.");
assert(end_spine_above_floor <= 2.60,
       "Keep the low RF-arm top within 2.60 mm of the inside floor.");
assert(end_spine_height >= minimum_wall_thickness && side_spine_height >= minimum_wall_thickness);
assert(root_blend_radius <= flexure_gap,
       "Do not fill the free flexure gap with an oversized anchor blend.");
assert(end_clip_root_x-end_clip_length >
       notch_half_width+abs(lanyard_centers[0][0])+0.80,
       "End tip must clear the U cut by at least 0.80 mm.");
assert(beam_contact_width >= minimum_wall_thickness && beam_notch_gap >= 1.0);
assert(beam_length >= 22 && beam_length <= 26 && beam_contact_clearance >= 0);
assert(beam_contact_clearance <= 0.3 && rear_clearance > beam_foot_flare+1);
assert(fit_frame_end_band > 6.592+pcb_slot_height/2+lanyard_clearance+3,
       "Fit-frame end band must bridge the full-depth lanyard opening.");
assert(seat_z-switch_wall_drop >= floor_thickness+minimum_wall_thickness,
       "Do not lower the switch access wall into the protective floor.");
echo("v1.13 backplate / inlay / Body backing mm",[floor_thickness,art_inlay_depth,floor_thickness-art_inlay_depth]);
echo("Layer plan: first 2 artwork+background; next 4 Body; no intermediate sparse layer");
echo("Side support station Y values with BOTH left/right mates",edge_seat_stations);
echo("Retainers: 4 side + 4 corner + 4 end = 12; all overlap 0.50 mm.");
echo("Low-spine end arm: length / spine height / radial thickness mm",
     [end_clip_length,end_spine_height,clip_wall]);
echo("Side arm length / spine height mm",[clip_length,side_spine_height]);
echo("Support beams: length / contact width / floor-to-PCB height mm",
     [beam_length,beam_contact_width,rear_clearance-beam_contact_clearance]);
echo("Reversed right clip: root Y / free tip Y (screen-view mm)",
     [right_lower_clip_root_y,right_lower_clip_tip_y]);
echo("Whole arm to modeled toggle housing longitudinal gap (mm)",
     right_lower_clip_tip_y-(switch_source_y_max-source_center[1]));
echo("Right fixed-wall support shelf center Y (mm)",right_lower_edge_seat_y);
echo("Switch access Y interval, screen-view mm",[switch_access_y_min,switch_access_y_max]);
echo("PCB lanyard width / height / open-cut clearance mm",
     [pcb_slot_width,pcb_slot_height,lanyard_clearance]);

assert(relief_height == 0, "This is a FLUSH variant; do not override relief_height.");
assert(art_inlay_depth > 0 && art_inlay_depth <= floor_thickness-0.72+0.000001,
    "Keep at least 0.72 mm (three 0.24-mm layers) of Body behind the inlay.");
assert(abs(floor_thickness/process_layer_height-round(floor_thickness/process_layer_height))<0.000001,
    "Backplate thickness must be a whole number of 0.24-mm layers.");
assert(floor_thickness >= 1.44, "Only the backplate may be reduced, down to 1.44 mm.");
assert(abs(art_inlay_depth/process_layer_height-round(art_inlay_depth/process_layer_height)) < 0.000001,
    "Use whole 0.24-mm layer increments for art_inlay_depth.");
assert(edge_clearance >= 0.15, "Increase per-side edge clearance.");
assert(rear_clearance >= 4.5, "Too little clearance for the modeled rear pins.");
assert(minimum_wall_thickness >= 2.40, "This variant requires at least 2.40 mm structural walls.");
assert(min([wall_thickness,clip_wall,corner_flex_wall,
            edge_seat_thickness,side_lip_thickness,corner_lip_thickness]) >= minimum_wall_thickness,
       "A structural thickness other than the backplate is below 2.40 mm.");
assert(wall_thickness >= clip_wall, "Wall must be at least clip_wall thick.");
assert(clip_length >= 20 && clip_length <= 25, "Keep clips in verified edge zones.");
assert(clip_overlap >= 0.25 && clip_overlap <= 0.50,
    "Use 0.25..0.50 mm nominal PCB-edge overlap; larger values require rechecking.");
assert(abs(corner_lip_overlap-clip_overlap)<0.000001,
    "Side and corner overlaps must match. Change clip_overlap only.");
assert(edge_seat_depth >= 0.60 && edge_seat_depth <= 1.00,
    "Keep edge seats inside the checked outermost 1.00 mm of PCB.");
assert(edge_seat_length >= 5 && edge_seat_length <= 7,
    "Keep edge seats within the checked fixed-wall zones.");
assert(edge_seat_thickness >= minimum_wall_thickness, "Seat shelf is below the structural minimum.");
assert(rear_clearance > edge_seat_thickness + edge_clearance + edge_seat_depth,
    "Not enough cavity height for the seat's 45-degree underside ramp.");

assert(!corner_lips_enabled || (corner_lip_overlap >= 0.25 && corner_lip_overlap <= 0.50),
    "Keep corner overlap linked to clip_overlap in the 0.25..0.50 mm range.");
assert(!corner_lips_enabled || (corner_vertical_play >= 0.10 && corner_vertical_play <= 0.50),
    "Keep a positive corner gap; do not clamp the PCB with an interference height.");
assert(!corner_lips_enabled || (corner_radial_clearance >= 0.15 && corner_radial_clearance <= edge_clearance),
    "Corner radial clearance must be >= 0.15 mm and <= edge_clearance.");
assert(!corner_lips_enabled || (corner_flex_wall >= minimum_wall_thickness && corner_flex_wall <= wall_thickness),
    "Corner wall must meet the structural minimum and be no thicker than the fixed wall.");
assert(!corner_lips_enabled || (corner_lip_angle >= 40 && corner_lip_angle <= 55 && corner_cut_angle < 80),
    "Keep the corner lip and slots clear of adjacent straight-edge features.");
assert(!corner_lips_enabled || corner_slot_gap >= 0.70, "Corner relief slots are too narrow.");
assert(!corner_lips_enabled || corner_lip_thickness >= minimum_wall_thickness, "Corner lip flat height is below the structural minimum.");
assert(!corner_lips_enabled || corner_root_top < seat_z-0.30, "Not enough corner flexure height.");

echo("Slicer reference: layer height / perimeters / top layers / bottom layers",
     [process_layer_height,process_perimeters,process_top_layers,process_bottom_layers]);
echo("Nominal side and corner PCB-edge overlaps (mm)", [clip_overlap,corner_lip_overlap]);
echo("Minimum structural wall (mm)", minimum_wall_thickness);
echo("Floor / fixed wall / side arm / corner wall / seat shelf / side lip / corner lip (mm)",
     [floor_thickness,wall_thickness,clip_wall,corner_flex_wall,edge_seat_thickness,side_lip_thickness,corner_lip_thickness]);
echo("WARNING: thicker clips require physical insertion/removal tests before batching.");
echo("v1.13: FLUSH artwork and background at Z=0; no hexagon pattern or raised rail.");
echo("Art depth / remaining body backing / total backplate (mm)",
    [art_inlay_depth,floor_thickness-art_inlay_depth,floor_thickness]);
echo("Total backplate / inlay layer counts at 0.24 mm", [floor_thickness/process_layer_height,art_inlay_depth/process_layer_height]);
echo("Measured PCB envelope (mm)", [reference_width,reference_height,pcb_thickness]);
echo("Shell XY envelope (mm)", [reference_width+2*(edge_clearance+wall_thickness),reference_height+2*(edge_clearance+wall_thickness)]);
echo("Floor-to-deepest-modeled-pin clearance (mm)", rear_clearance-3.86);
echo("Print height (mm)", max(arm_top,corner_lips_enabled?corner_top:0)+relief_height);
echo("Rear hardware projection budget with 0.60 mm margin (mm)", rear_clearance-0.60);
echo("PCB edge seat depth / length (mm)", [edge_seat_depth,edge_seat_length]);
echo("Cover attachment: snap clips only; no screw holes and no mounting posts.");
if(corner_lips_enabled) {
    echo("Corner lips: count / overlap / vertical gap / radial gap (mm)",
         [4,corner_lip_overlap,corner_vertical_play,corner_radial_clearance]);
    echo("Corner PCB-edge arc length (mm)", corner_radius*corner_lip_angle*PI/180);
}
board_outline_points = [
    [53.08411, 73.96698],
    [52.79952, 74.35017],
    [52.36392, 74.81405],
    [51.87359, 75.21968],
    [51.33629, 75.56066],
    [50.76050, 75.83160],
